@page "/agent/stats"
@attribute [Authorize]
@using MudBlazor
@using RealEstateApp.Models
@using RealEstateApp.Data.Repositories
@inject IDashboardRepository DashboardRepo
<PageTitle>Миний сарын статистик</PageTitle>

<div class="ms">
    <SiteHeader />

    <div class="ms-container">
        <div class="ms-top">
            <div>
                <h1 class="ms-h1">Миний сарын статистик</h1>
                <p class="ms-sub">Сараа сонгож өөрийн гүйцэтгэлээ хараарай</p>
            </div>

            <div class="ms-picker">
                <MudSelect T="int" Value="_year" ValueChanged="OnYearChanged" Label="Жил"
                           Variant="Variant.Outlined" Margin="Margin.Dense">
                    @foreach (var y in YearOptions)
                    {
                        <MudSelectItem T="int" Value="@y">@y</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="int" Value="_month" ValueChanged="OnMonthChanged" Label="Сар"
                           Variant="Variant.Outlined" Margin="Margin.Dense">
                    @for (var m = 1; m <= 12; m++)
                    {
                        var mm = m;
                        <MudSelectItem T="int" Value="@mm">@MonthName(mm)</MudSelectItem>
                    }
                </MudSelect>
            </div>
        </div>

        @if (_loading)
        {
            <div class="ms-center"><MudProgressCircular Indeterminate="true" Color="Color.Primary" /></div>
        }
        else if (_stats is null)
        {
            <div class="ms-empty">
                <MudIcon Icon="@Icons.Material.Filled.BarChart" Size="Size.Large" />
                <p>Статистик ачаалахад алдаа гарлаа.</p>
                @if (!string.IsNullOrEmpty(_loadError))
                {
                    <p class="ms-error-detail">@_loadError</p>
                }
            </div>
        }
        else
        {
            <div class="ms-stats">
                <div class="ms-stat">
                    <div class="ms-stat-icon"><MudIcon Icon="@Icons.Material.Filled.AddHome" /></div>
                    <div class="ms-stat-num">@_stats.NewListingsCount</div>
                    <div class="ms-stat-lbl">Шинэ лист (@MonthName(_month))</div>
                </div>
                <div class="ms-stat">
                    <div class="ms-stat-icon"><MudIcon Icon="@Icons.Material.Filled.CheckCircle" /></div>
                    <div class="ms-stat-num">@_stats.SoldCount</div>
                    <div class="ms-stat-lbl">Борлуулалт хийгдсэн</div>
                </div>
                <div class="ms-stat ms-stat-wide">
                    <div class="ms-stat-icon"><MudIcon Icon="@Icons.Material.Filled.Payments" /></div>
                    <div class="ms-stat-num">@Money(_stats.SoldTotalAmount)</div>
                    <div class="ms-stat-lbl">Борлуулалтын дүн</div>
                    @if (ChangeLabel is not null)
                    {
                        <div class="ms-change @ChangeClass">
                            <MudIcon Icon="@ChangeIcon" Size="Size.Small" /> @ChangeLabel · өмнөх сараас
                        </div>
                    }
                </div>
                <div class="ms-stat">
                    <div class="ms-stat-icon"><MudIcon Icon="@Icons.Material.Filled.HomeWork" /></div>
                    <div class="ms-stat-num">@_stats.ActivePropertiesCount</div>
                    <div class="ms-stat-lbl">Идэвхтэй лист (нийт)</div>
                </div>
            </div>

            <p class="ms-note">
                <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" />
                Хамтран борлуулсан хаалт таны хувийн тоонд бүтэн дүнгээрээ (хуваахгүйгээр) орно.
            </p>
        }
    </div>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private int _agentId;
    private bool _loading = true;
    private int _year = DateTime.Today.Year;
    private int _month = DateTime.Today.Month;
    private AgentMonthlyStats? _stats;
    private string? _loadError;

    private static readonly string[] MonthNames =
    {
        "1-р сар", "2-р сар", "3-р сар", "4-р сар", "5-р сар", "6-р сар",
        "7-р сар", "8-р сар", "9-р сар", "10-р сар", "11-р сар", "12-р сар"
    };

    private static string MonthName(int m) => MonthNames[m - 1];

    private IEnumerable<int> YearOptions
    {
        get
        {
            var current = DateTime.Today.Year;
            for (var y = current; y >= current - 3; y--) yield return y;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState;
        _agentId = auth.User.GetAgentId();
        await LoadAsync();
    }

    private async Task OnYearChanged(int year)
    {
        _year = year;
        await LoadAsync();
    }

    private async Task OnMonthChanged(int month)
    {
        _month = month;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            _stats = await DashboardRepo.GetAgentMonthlyStatsAsync(_agentId, _year, _month);
        }
        catch (Exception ex)
        {
            _stats = null;
            _loadError = ex.InnerException?.Message ?? ex.Message;
        }
        _loading = false;
    }

    // Өмнөх сартай харьцуулсан хувийн өөрчлөлт
    private string? ChangeLabel
    {
        get
        {
            if (_stats is null) return null;
            var prev = _stats.PrevMonthSoldTotalAmount;
            var cur = _stats.SoldTotalAmount;

            if (prev <= 0)
                return cur > 0 ? "Шинэ" : null;

            var pct = Math.Round((cur - prev) / prev * 100, 1);
            var sign = pct > 0 ? "+" : "";
            return $"{sign}{pct.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)}%";
        }
    }

    private string ChangeClass
    {
        get
        {
            if (_stats is null) return "";
            var prev = _stats.PrevMonthSoldTotalAmount;
            var cur = _stats.SoldTotalAmount;
            if (prev <= 0) return cur > 0 ? "up" : "";
            return cur >= prev ? "up" : "down";
        }
    }

    private string ChangeIcon
    {
        get
        {
            if (_stats is null) return Icons.Material.Filled.TrendingFlat;
            var prev = _stats.PrevMonthSoldTotalAmount;
            var cur = _stats.SoldTotalAmount;
            if (prev <= 0) return cur > 0 ? Icons.Material.Filled.TrendingUp : Icons.Material.Filled.TrendingFlat;
            if (cur > prev) return Icons.Material.Filled.TrendingUp;
            if (cur < prev) return Icons.Material.Filled.TrendingDown;
            return Icons.Material.Filled.TrendingFlat;
        }
    }

    private static string Money(decimal v) =>
        v <= 0 ? "-" : v.ToString("#,##0", System.Globalization.CultureInfo.InvariantCulture) + "₮";
}
