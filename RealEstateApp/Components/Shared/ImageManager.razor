@using MudBlazor
@using RealEstateApp.Models
@using RealEstateApp.Data.Repositories
@using RealEstateApp.Services
@inject IPropertyImageRepository ImageRepo
@inject IImageStorageService Storage
@inject ISnackbar Snackbar

<div class="im">
    <div class="im-head">
        <h3 class="im-h">Зураг (@_images.Count)</h3>
        <label class="im-upload @(_busy ? "disabled" : "")">
            <MudIcon Icon="@Icons.Material.Filled.CloudUpload" Size="Size.Small" />
            @(_busy ? "Хуулж байна…" : "Зураг нэмэх")
            <InputFile OnChange="OnFilesSelected" multiple accept="image/*" disabled="@_busy" />
        </label>
    </div>

    <p class="im-hint">JPG, PNG, WEBP · нэг файл 5MB хүртэл · эхний зураг үндсэн зураг болно · зургийг чирж эсвэл сумаар зөөж эрэмбийг өөрчилнө үү</p>

    @if (_images.Count == 0)
    {
        <div class="im-empty">
            <MudIcon Icon="@Icons.Material.Filled.PhotoLibrary" Size="Size.Large" />
            <p>Зураг байхгүй байна.</p>
        </div>
    }
    else
    {
        <div class="im-grid">
            @for (int i = 0; i < _images.Count; i++)
            {
                var index = i;
                var image = _images[index];
                <div class="im-item @(image.IsMain ? "main" : "") @(_dragIndex == index ? "dragging" : "") @(_dragOverIndex == index && _dragIndex != index ? "drag-over" : "")"
                     draggable="true"
                     @ondragstart="() => OnDragStart(index)"
                     @ondragover="() => OnDragOver(index)"
                     @ondragover:preventDefault="true"
                     @ondrop="() => OnDropAsync(index)"
                     @ondrop:preventDefault="true"
                     @ondragend="OnDragEnd">
                    <div class="im-thumb" style="background-image:url('@image.ImagePath')"></div>
                    <span class="im-order" title="Байрлал">@(index + 1)</span>
                    <span class="im-drag" title="Чирж зөөх"><MudIcon Icon="@Icons.Material.Filled.DragIndicator" Size="Size.Small" /></span>
                    @if (image.IsMain)
                    {
                        <span class="im-badge">Үндсэн</span>
                    }
                    <div class="im-tools">
                        <button type="button" class="im-tool" title="Нэг байр урагшлуулах" disabled="@(_busy || index == 0)"
                                @onclick="() => MoveAsync(index, index - 1)">
                            <MudIcon Icon="@Icons.Material.Filled.ArrowBackIosNew" Size="Size.Small" />
                        </button>
                        <button type="button" class="im-tool" title="Нэг байр хойшлуулах" disabled="@(_busy || index == _images.Count - 1)"
                                @onclick="() => MoveAsync(index, index + 1)">
                            <MudIcon Icon="@Icons.Material.Filled.ArrowForwardIos" Size="Size.Small" />
                        </button>
                        @if (!image.IsMain)
                        {
                            <button type="button" class="im-tool" title="Үндсэн болгох" disabled="@_busy"
                                    @onclick="() => SetMainAsync(image.ImageId)">
                                <MudIcon Icon="@Icons.Material.Filled.Star" Size="Size.Small" />
                            </button>
                        }
                        <button type="button" class="im-tool del" title="Устгах" disabled="@_busy"
                                @onclick="() => DeleteAsync(image.ImageId)">
                            <MudIcon Icon="@Icons.Material.Filled.Delete" Size="Size.Small" />
                        </button>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public int PropertyId { get; set; }
    [Parameter] public int ActorAgentId { get; set; }

    private List<PropertyImage> _images = new();
    private bool _busy;
    private int? _dragIndex;
    private int? _dragOverIndex;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync() => _images = await ImageRepo.ListAsync(PropertyId);

    private async Task OnFilesSelected(InputFileChangeEventArgs e)
    {
        _busy = true;
        try
        {
            var files = e.GetMultipleFiles(20);
            int ok = 0;

            foreach (var file in files)
            {
                if (!Storage.IsAllowed(file, out var err))
                {
                    Snackbar.Add(err, Severity.Warning);
                    continue;
                }

                try
                {
                    var uploaded = await Storage.UploadAsync(file, PropertyId);
                    var res = await ImageRepo.InsertAsync(PropertyId, uploaded.Url, uploaded.PublicId, ActorAgentId);

                    if (res.Ok)
                    {
                        ok++;
                    }
                    else
                    {
                        // Баазад орж чадаагүй бол Cloudinary-оос ч хасна
                        await Storage.DeleteAsync(uploaded.PublicId);
                        Snackbar.Add(res.Message, Severity.Error);
                    }
                }
                catch (Exception ex)
                {
                    Snackbar.Add($"{file.Name}: {ex.Message}", Severity.Error);
                }
            }

            if (ok > 0)
            {
                Snackbar.Add($"{ok} зураг нэмэгдлээ.", Severity.Success);
                await ReloadAsync();
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SetMainAsync(int imageId)
    {
        _busy = true;
        try
        {
            var res = await ImageRepo.SetMainAsync(imageId, ActorAgentId);
            Snackbar.Add(res.Message, res.Ok ? Severity.Success : Severity.Error);
            if (res.Ok) await ReloadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Алдаа: {ex.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private void OnDragStart(int index)
    {
        _dragIndex = index;
        _dragOverIndex = null;
    }

    private void OnDragOver(int index)
    {
        if (_dragIndex is null || _dragIndex == index) return;
        _dragOverIndex = index;
    }

    private void OnDragEnd()
    {
        _dragIndex = null;
        _dragOverIndex = null;
    }

    private async Task OnDropAsync(int dropIndex)
    {
        var fromIndex = _dragIndex;
        _dragIndex = null;
        _dragOverIndex = null;

        if (fromIndex is null || fromIndex == dropIndex) return;
        await MoveAsync(fromIndex.Value, dropIndex);
    }

    private async Task MoveAsync(int fromIndex, int toIndex)
    {
        if (_busy) return;
        if (fromIndex < 0 || fromIndex >= _images.Count) return;
        if (toIndex < 0 || toIndex >= _images.Count) return;
        if (fromIndex == toIndex) return;

        var reordered = _images.ToList();
        var moved = reordered[fromIndex];
        reordered.RemoveAt(fromIndex);
        reordered.Insert(toIndex, moved);

        // Дэлгэц дээр даруй харуулна (сервертэй зэрэгцэн)
        _images = reordered;
        StateHasChanged();

        _busy = true;
        try
        {
            var res = await ImageRepo.ReorderAsync(PropertyId, reordered.Select(x => x.ImageId).ToList(), ActorAgentId);
            if (!res.Ok)
            {
                Snackbar.Add(res.Message, Severity.Error);
                await ReloadAsync();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Алдаа: {ex.Message}", Severity.Error);
            await ReloadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteAsync(int imageId)
    {
        _busy = true;
        try
        {
            var (res, publicId) = await ImageRepo.DeleteAsync(imageId, ActorAgentId);
            if (res.Ok)
            {
                await Storage.DeleteAsync(publicId);
                Snackbar.Add(res.Message, Severity.Success);
                await ReloadAsync();
            }
            else
            {
                Snackbar.Add(res.Message, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Алдаа: {ex.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }
}